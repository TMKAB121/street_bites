APP_NAME="Steet Bites"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://steet-bites.lndo.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB runs in the `database` Lando container (internal Docker hostname).
DB_CONNECTION=mariadb
DB_HOST=database
DB_PORT=3306
DB_DATABASE=steet_bites
DB_USERNAME=steet_bites
DB_PASSWORD=steet_bites

# Redis runs in the `cache` Lando container.
REDIS_CLIENT=phpredis
REDIS_HOST=cache
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=steet_bites
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Cookie hardening (NIST SP 800-63B): only send the session cookie over HTTPS,
# keep it out of JS, and encrypt the stored payload. APP_URL is https locally
# (lndo.site), so the Secure flag does not break local sign-in.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

# Password hashing: memory-hard Argon2id (see config/hashing.php).
HASH_DRIVER=argon2id

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Truck images and cached map PNGs are written through this disk name (see
# config/filesystems.php). Local dev/test leave it as "public" (local disk).
# Production (ECS/Fargate — no shared/persistent local disk) sets this to "s3"
# and fills in the AWS_* vars below; no application code changes needed.
FILESYSTEM_PUBLIC_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Content moderation.
# ADMIN_EMAILS: comma-separated allowlist of moderation admins (/admin/trucks).
ADMIN_EMAILS=sayge.dev121@gmail.com
# Image screening via AWS Rekognition. Leave disabled locally/CI (never calls
# AWS — screening fails open to "passed"); enable in production. Region falls
# back to AWS_DEFAULT_REGION. Text screening (a word-list) always runs.
MODERATION_REKOGNITION_ENABLED=false
# MODERATION_REKOGNITION_MIN_CONFIDENCE=80
# MODERATION_REKOGNITION_REGION=
# MODERATION_TEXT_BLOCKLIST=

# Reverb app credentials (used by both server-side and browser).
# Generate a fresh set with `lando artisan reverb:install` or set your own.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# REVERB_HOST = Docker service name so PHP in appserver can reach the reverb
# container on the internal Docker network when broadcasting events server-side.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite exposes these to the browser. The browser reaches Reverb via the
# portforward (localhost:8080), NOT the internal Docker hostname.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@steet-bites.test"
MAIL_FROM_NAME="${APP_NAME}"
