# Dependencies
/node_modules
/vendor

# Laravel
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
!storage/logs/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
!bootstrap/cache/.gitkeep

# Environment
.env
.env.*
!.env.example

# Auth / credentials
/auth.json

# Testing
.phpunit.result.cache
/.phpunit.cache
/coverage

# IDE / editors
/.idea
/.vscode
/.nova
/.zed
# .claude: track only the repo's agents + skills; ignore worktrees, local settings, etc.
/.claude/*
!/.claude/agents/
!/.claude/skills/
/.cursor/
/.codex
/.phpactor.json
_ide_helper.php
_ide_helper_models.php
.php-cs-fixer.cache

# Vagrant / Homestead
Homestead.json
Homestead.yaml

# Lando (keep .lando.yml, ignore local overrides)
.lando.local.yml
.lando.local.yaml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Vite
/public/fonts-manifest.dev.json

# Misc
*.cache

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
# .terraform.lock.hcl is intentionally NOT ignored — commit it for reproducible provider versions.
