# Copy to terraform.tfvars (gitignored) and fill in. Nothing here is a secret
# — real secrets (DB password, APP_KEY, Reverb credentials) are generated by
# Terraform itself in secrets.tf and stored in Secrets Manager, never in a
# tfvars file.

aws_region      = "us-east-1"
project         = "street-bites"
s3_bucket_name  = "street-bites-public-storage" # must be globally unique — change this
image_tag       = "initial"                     # release-deploy.yml overrides this on every deploy
