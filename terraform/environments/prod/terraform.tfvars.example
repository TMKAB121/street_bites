# Copy to terraform.tfvars (gitignored) and fill in. The only secret here is
# resend_api_key — it's externally issued (Resend dashboard) so Terraform
# can't generate it; every other secret (DB password, APP_KEY, Reverb
# credentials) is generated by Terraform itself in secrets.tf and stored in
# Secrets Manager, never in a tfvars file.

aws_region      = "us-east-1"
project         = "street-bites"
s3_bucket_name  = "street-bites-public-storage" # must be globally unique — change this
image_tag       = "initial"                     # release-deploy.yml overrides this on every deploy
resend_api_key  = "re_..."                      # Resend dashboard → API Keys (sending-only, scoped to the domain)
